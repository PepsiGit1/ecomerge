generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String          @id @default(uuid())
  email          String          @unique
  name           String          @unique
  phone          String          @unique
  address        String?
  province       String?
  district       String?
  image          String?
  isActive       Boolean         @default(true)
  isVerified     Boolean         @default(false)
  password       String
  role           Role            @default(USER)
  createdAt      DateTime        @default(now())
  village        String?
  productRatings ProductRating[] @relation("UserRatings")

  @@index([isActive])
}

model Product {
  id             String          @id @default(uuid())
  name           String
  description    String?
  price          Float
  image          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  embedding      Float[]
  categoryId     String?
  brand          String
  size           String[]
  rating         Float           @default(0)
  ratingCount    Int             @default(0)
  discounts      Discount[]
  category       Category?       @relation(fields: [categoryId], references: [id])
  productRatings ProductRating[]

  @@index([name])
}

model ProductRating {
  id        String   @id @default(uuid())
  userId    String
  productId String
  rating    Float
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id])
  user      User     @relation("UserRatings", fields: [userId], references: [id])

  @@unique([userId, productId])
}

model Discount {
  id        String   @id @default(uuid())
  productId String
  type      String
  value     Float
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  product   Product  @relation(fields: [productId], references: [id])
}

model Category {
  id        String             @id @default(uuid())
  name      String             @unique
  image     String
  discounts CategoryDiscount[]
  products  Product[]
}

model CategoryDiscount {
  id          String   @id @default(uuid())
  categoryId  String
  type        String
  value       Float
  minQuantity Int?
  startDate   DateTime
  endDate     DateTime
  isActive    Boolean  @default(true)
  category    Category @relation(fields: [categoryId], references: [id])
}

model AuthStatus {
  id         Int       @id @default(autoincrement())
  userId     String    @unique
  isLoggedIn Boolean   @default(false)
  lastLogin  DateTime  @default(now())
  lastLogout DateTime?
}

enum Role {
  USER
  ADMIN
}

enum PaymentMethod {
  cash
  card
  wallet
}
